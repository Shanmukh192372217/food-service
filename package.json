{
  "name": "food-service-e2e-automation",
  "version": "1.0.0",
  "description": "Enterprise E2E Selenium Automation Framework for Food Service App",
  "main": "index.js",
  "scripts": {
    "test": "mocha tests/**/*.test.js --timeout 60000 --reporter mochawesome --reporter-options reportDir=reports,reportFilename=E2E_HTML_Report",
    "test:chrome": "SET BROWSER=chrome&& npm test",
    "test:headless": "SET HEADLESS=true&& npm test",
    "test:cross-browser": "npm run test:chrome && npm run test:firefox && npm run test:edge"
  },
  "dependencies": {
    "selenium-webdriver": "^4.10.0",
    "mocha": "^10.2.0",
    "chai": "^4.3.7",
    "exceljs": "^4.3.0",
    "mochawesome": "^7.1.3",
    "winston": "^3.10.0",
    "dotenv": "^16.3.1",
    "moment": "^2.29.4"
  }
}
